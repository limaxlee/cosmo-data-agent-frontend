# Copy this file to `.env` and fill in the values for your environment:
#   cp .env.example .env

# --- Backend API ------------------------------------------------------------

# Origin of the ADK backend. REQUIRED -- the app cannot load or create chat
# sessions without it.
#
# Server-side only: it is read by the Next.js server (the /api/chat route and
# the /backend/* proxy), never by the browser. The browser always calls this
# app's own origin, so the backend does not need to be reachable from the
# user's machine and does not need to send any CORS headers.
#
# Because it is read at request time, `docker run -e BACKEND_ORIGIN=...` is
# enough to repoint a built image -- no rebuild.
#
# No trailing slash.
BACKEND_ORIGIN=http://localhost:8080

# --- Where the app is served ------------------------------------------------

# The path the app is served under. NEXT_PUBLIC_, so it is fixed at build time:
# Next.js bakes it into every address it generates, and the client code reads
# it through src/lib/base-path.ts.
#
# Leave it empty for local development. The app is then at the top of the
# site: http://localhost:3000/chat/new.
#
# Behind the DICE address the app lives under /data-agent, and the gateway
# passes that path on unchanged, so the build has to know it. The Dockerfile
# sets /data-agent as the default build arg -- a plain `docker build` is the
# production build.
#
# Leading slash, no trailing slash. An empty value or "/" means no base path.
#
# On Windows, set it here (or in PowerShell), not on a Git Bash command line:
# Git Bash rewrites a value that starts with "/" into a Windows folder path.
NEXT_PUBLIC_BASE_PATH=

# --- Login (local development only) -----------------------------------------

# People log in through the DICE login service, which answers under /auth/...
# on the DICE address only. On localhost there is no such service, and the app
# stops at "Could not check your login".
#
# For local development, run the stand-in in a second terminal:
#
#   node dev/mock-login-service.mjs
#
# and uncomment the line below. next.config.mjs then sends /auth/... to it.
# The stand-in's own settings (login ID, secret, lifetimes) are described at
# the top of that script.
#
# Never set this for a deployment. It is not set in the Docker build, and then
# the rule does not exist: /auth/... belongs to the real login service.
# AUTH_DEV_PROXY_TARGET=http://127.0.0.1:13081

# --- App defaults -----------------------------------------------------------
#
# Both are NEXT_PUBLIC_, which means Next.js inlines them into the client bundle
# at build time -- changing them requires a rebuild, and anyone who loads the app
# can read them. Do not put secrets here.

# Browser tab title and metadata title.
# Optional. Falls back to "Data Agent" when unset.
NEXT_PUBLIC_APP_TITLE=Data Agent

# Maximum number of characters accepted in a single chat message.
# Enforced in the composer and again server-side by the /api/chat route, which
# returns 413 when exceeded.
# Optional. Falls back to 100000 when unset.
NEXT_PUBLIC_MAX_INPUT_LENGTH=100000
