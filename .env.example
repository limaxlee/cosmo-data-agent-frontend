# Copy this file to `.env` and fill in the values for your environment:
#   cp .env.example .env

# --- Backend API ------------------------------------------------------------

# Origin of the ADK backend. REQUIRED -- the app cannot load or create chat
# sessions without it.
#
# Server-side only: it is read by the Next.js server (the /api/chat route and
# the /backend/* proxy), never by the browser. The browser always calls this
# app's own origin, so the backend does not need to be reachable from the
# user's machine and does not need to send any CORS headers.
#
# Because it is read at request time, `docker run -e BACKEND_ORIGIN=...` is
# enough to repoint a built image -- no rebuild.
#
# No trailing slash.
BACKEND_ORIGIN=http://localhost:8080

# --- App defaults -----------------------------------------------------------
#
# Both are NEXT_PUBLIC_, which means Next.js inlines them into the client bundle
# at build time -- changing them requires a rebuild, and anyone who loads the app
# can read them. Do not put secrets here.

# Browser tab title and metadata title.
# Optional. Falls back to "Data Agent" when unset.
NEXT_PUBLIC_APP_TITLE=Data Agent

# Maximum number of characters accepted in a single chat message.
# Enforced in the composer and again server-side by the /api/chat route, which
# returns 413 when exceeded.
# Optional. Falls back to 100000 when unset.
NEXT_PUBLIC_MAX_INPUT_LENGTH=100000
